---
import { cn } from '@/utils'
const URL = Astro.url.href
---

<div class='flex flex-col gap-2 text-main'>
	<span class='mb-1 font-bold text-2xl'>Share</span>
	<button
		id='copy-link-btn'
		class={cn(
			'bg-red-800 dark:bg-red-900 dark:hover:bg-red-400 hover:bg-red-300 font-bold text-white py-1 px-4 rounded-full w-fit'
		)}
		data-url={URL}
		aria-label='Copy link to clipboard'
	>
		<span id='button-text'>Copy Link</span>
	</button>
</div>

<script>
	const button = document.getElementById('copy-link-btn')
	const buttonText = document.getElementById('button-text')

	if (button && buttonText) {
		button.addEventListener('click', async () => {
			const url = button.getAttribute('data-url')

			if (url) {
				try {
					await navigator.clipboard.writeText(url)
					buttonText.textContent = 'Copied!'

					setTimeout(() => {
						buttonText.textContent = 'Copy Link'
					}, 2000)
				} catch (err) {
					console.error('Failed to copy:', err)
					buttonText.textContent = 'Failed to copy'

					setTimeout(() => {
						buttonText.textContent = 'Copy Link'
					}, 2000)
				}
			}
		})
	}
</script>
