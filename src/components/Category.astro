---
import { cn, sluglify } from '@/utils'

const { name = 'View All', activeCategory } = Astro.props
const currentPath = Astro.url.pathname
const unsluglifyNameCategory = sluglify(name.toLowerCase())

const isActive =
	activeCategory?.toLocaleLowerCase() === unsluglifyNameCategory ||
	(currentPath === '/' && name === 'View All')
---

<a
	href={name === 'View All' ? '/' : sluglify(`/category/${unsluglifyNameCategory}/1`)}
	class={cn(
		`text-main  pb-2.5 first-letter:uppercase font-medium hover:text-black hover:dark:text-white border-b-2 border-opacity-0 dark:border-opacity-0 border-black dark:border-white dark:hover:border-main hover:border-opacity-100 hover:border-main transition-colors duration-150 ease-linear  `,
		isActive &&
			`border-red-800 border-b-2 text-main z-10  dark:border-red-900 dark:border-opacity-100 border-opacity-100`
	)}
>
	{name}
</a>
